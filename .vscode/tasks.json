{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: Build",
      "type": "shell",
      "command": "./mvnw clean compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: Test",
      "type": "shell",
      "command": "./mvnw test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: Run Application",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Maven: Package JAR",
      "type": "shell",
      "command": "./mvnw clean package -DskipTests",
      "group": "none",
      "problemMatcher": ["$maven"]
    }
  ]
}
